---
// NavBar.astro — Barra de navegación flotante
---

<nav class="navbar" id="navbar">
  <div class="navbar-inner">
    <span class="navbar-brand">
      <span class="brand-accent">I</span>L
    </span>
    <ul class="navbar-links">
      <li><a href="#sobre-mi">Sobre mí</a></li>
      <li><a href="#habilidades">Habilidades</a></li>
      <li><a href="#experiencia">Experiencia</a></li>
      <li><a href="#educacion">Educación</a></li>
      <li><a href="#certificaciones">Certificaciones</a></li>
      <li><a href="#contacto">Contacto</a></li>
    </ul>
    <button class="navbar-download btn btn-primary" onclick="window.print()">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
        <polyline points="7 10 12 15 17 10"/>
        <line x1="12" y1="15" x2="12" y2="3"/>
      </svg>
      PDF
    </button>
  </div>
</nav>

<style>
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: 0 1.5rem;
    transform: translateY(-100%);
    transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1), background 0.35s ease;
    background: rgba(8, 13, 26, 0.85);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(99, 102, 241, 0.12);
  }

  .navbar.visible {
    transform: translateY(0);
  }

  .navbar-inner {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 2rem;
    height: 60px;
  }

  .navbar-brand {
    font-size: 1.1rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    color: var(--text-primary);
    flex-shrink: 0;
  }

  .brand-accent {
    color: var(--accent-light);
  }

  .navbar-links {
    display: flex;
    gap: 0.25rem;
    flex: 1;
    justify-content: center;
  }

  .navbar-links a {
    padding: 0.4rem 0.75rem;
    border-radius: 6px;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--text-secondary);
    transition: var(--transition);
  }

  .navbar-links a:hover {
    color: var(--text-primary);
    background: var(--accent-glow-sm);
  }

  .navbar-download {
    padding: 0.45rem 1rem;
    font-size: 0.8rem;
    flex-shrink: 0;
  }

  @media (max-width: 768px) {
    .navbar-links { display: none; }
  }
</style>

<script>
  const navbar = document.getElementById('navbar');
  const heroHeight = window.innerHeight * 0.6;

  window.addEventListener('scroll', () => {
    if (window.scrollY > heroHeight) {
      navbar?.classList.add('visible');
    } else {
      navbar?.classList.remove('visible');
    }
  }, { passive: true });
</script>
