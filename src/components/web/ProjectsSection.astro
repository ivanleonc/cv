---
// ProjectsSection.astro — Portafolio de proyectos (solo web)
import { cv } from '../../data/cv.js';

const { projects } = cv;
---

<section class="section projects-section" id="proyectos" aria-labelledby="proyectos-title">
  <div class="projects-glow" aria-hidden="true"></div>

  <div class="container">
    <div class="section-header" data-animate>
      <p class="section-label">Portafolio</p>
      <h2 class="section-title" id="proyectos-title">Proyectos</h2>
      <p class="section-desc">
        Productos y aplicaciones que he desarrollado, desde plataformas de IA conversacional
        hasta un SaaS multi-tenant con analítica.
      </p>
    </div>

    <div class="projects-grid">
      {projects.map((project, i) => (
        <article
          class="project-card"
          data-animate
          style={`animation-delay: ${i * 0.12}s`}
          aria-labelledby={`${project.id}-title`}
        >
          <div class="project-media">
            <div class="browser-bar" aria-hidden="true">
              <span class="browser-dots">
                <span class="browser-dot dot-red"></span>
                <span class="browser-dot dot-yellow"></span>
                <span class="browser-dot dot-green"></span>
              </span>
              <span class="browser-title">{project.name}</span>
              <span class="browser-lock">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false">
                  <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                </svg>
              </span>
            </div>

            <img
              src={project.image}
              alt={project.imageAlt}
              width={project.imageWidth}
              height={project.imageHeight}
              loading="lazy"
              decoding="async"
            />
          </div>

          <div class="project-body">
            <div class="project-meta">
              <span class={`project-status status-${project.statusTone}`}>
                <span class="status-dot" aria-hidden="true"></span>
                {project.status}
              </span>
              <span class="project-period">{project.period}</span>
            </div>

            <h3 class="project-title" id={`${project.id}-title`}>{project.name}</h3>
            <p class="project-context">{project.context} · {project.type}</p>

            <p class="project-summary">{project.summary}</p>

            <ul class="project-highlights">
              {project.highlights.map((highlight) => (
                <li>
                  <span class="highlight-icon" aria-hidden="true">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" focusable="false">
                      <polyline points="20 6 9 17 4 12"/>
                    </svg>
                  </span>
                  {highlight}
                </li>
              ))}
            </ul>

            <div class="project-stack" aria-label={`Tecnologías de ${project.name}`}>
              {project.stack.map((tech) => (
                <span class="pill pill-tech">{tech}</span>
              ))}
            </div>

            {project.links.length > 0 && (
              <div class="project-links">
                {project.links.map((link) => (
                  <a
                    class="project-link"
                    href={link.url}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {link.icon === 'github' ? (
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                        <path d="M12 .5C5.73.5.5 5.73.5 12c0 5.09 3.29 9.4 7.86 10.93.58.11.79-.25.79-.56v-2.1c-3.2.7-3.88-1.36-3.88-1.36-.52-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.23-1.28-5.23-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.47.11-3.06 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.77.11 3.06.74.81 1.19 1.84 1.19 3.1 0 4.43-2.69 5.4-5.25 5.69.41.35.78 1.05.78 2.12v3.14c0 .31.21.68.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5Z"/>
                      </svg>
                    ) : (
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                        <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
                        <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z"/>
                      </svg>
                    )}
                    {link.label}
                    <span class="visually-hidden"> (se abre en una nueva pestaña)</span>
                    <svg class="external-icon" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                      <polyline points="15 3 21 3 21 9"/>
                      <line x1="10" y1="14" x2="21" y2="3"/>
                    </svg>
                  </a>
                ))}
              </div>
            )}

            {project.note && project.links.length === 0 && (
              <p class="project-note">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                  <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                </svg>
                {project.note}
              </p>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .projects-section {
    background: var(--bg-primary);
    overflow: hidden;
  }

  .projects-glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 45% 55% at 15% 20%, rgba(99, 102, 241, 0.09) 0%, transparent 65%),
      radial-gradient(ellipse 40% 50% at 85% 80%, rgba(79, 70, 229, 0.07) 0%, transparent 65%);
    pointer-events: none;
  }

  .container {
    position: relative;
    z-index: 1;
  }

  .section-header {
    margin-bottom: 3rem;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
    align-items: stretch;
  }

  .project-card {
    display: flex;
    flex-direction: column;
    background: var(--bg-card);
    border: 1px solid var(--border-soft);
    border-radius: var(--card-radius);
    overflow: hidden;
    transition: var(--transition);
  }

  .project-card:hover {
    border-color: var(--border);
    box-shadow: var(--shadow-hover);
    transform: translateY(-4px);
  }

  /* ── Captura en marco de navegador ─────────────────────── */
  .project-media {
    position: relative;
    background: #0b1220;
    border-bottom: 1px solid var(--border-soft);
    overflow: hidden;
  }

  .browser-bar {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.55rem 0.85rem;
    background: var(--bg-secondary);
    border-bottom: 1px solid var(--border-soft);
  }

  .browser-dots {
    display: flex;
    gap: 4px;
    flex-shrink: 0;
  }

  .browser-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    display: block;
  }

  .dot-red { background: #f87171; }
  .dot-yellow { background: #fbbf24; }
  .dot-green { background: #34d399; }

  .browser-title {
    flex: 1;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: var(--text-muted);
    letter-spacing: 0.04em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .browser-lock {
    display: inline-flex;
    color: var(--text-muted);
    flex-shrink: 0;
  }

  .project-media img {
    width: 100%;
    height: auto;
    aspect-ratio: 2.15 / 1;
    object-fit: cover;
    object-position: top center;
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .project-card:hover .project-media img {
    transform: scale(1.02);
  }

  /* ── Contenido ─────────────────────────────────────────── */
  .project-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.35rem 1.5rem 1.5rem;
  }

  .project-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 0.85rem;
  }

  .project-status {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.28rem 0.65rem;
    border-radius: var(--pill-radius);
    font-size: 0.68rem;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
  }

  .status-product {
    color: var(--text-accent);
    background: rgba(99, 102, 241, 0.12);
    border: 1px solid rgba(99, 102, 241, 0.25);
  }

  .status-wip {
    color: var(--status-wip-text);
    background: var(--status-wip-bg);
    border: 1px solid var(--status-wip-border);
  }

  .status-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: currentColor;
  }

  .project-period {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .project-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.2rem;
  }

  .project-context {
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--accent-light);
    margin-bottom: 0.85rem;
  }

  .project-summary {
    font-size: 0.85rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: 1rem;
  }

  .project-highlights {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    margin-bottom: 1.15rem;
  }

  .project-highlights li {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    font-size: 0.8rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  .highlight-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    margin-top: 0.1rem;
    border-radius: 50%;
    color: var(--accent-light);
    background: var(--accent-glow-sm);
    border: 1px solid var(--border-soft);
  }

  .project-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: auto;
  }

  .project-stack .pill {
    font-size: 0.66rem;
    padding: 0.22rem 0.55rem;
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.15rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-soft);
  }

  .project-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.42rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: var(--pill-radius);
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--accent-light);
    transition: var(--transition);
  }

  .project-link:hover {
    background: var(--accent-glow-sm);
    border-color: var(--border-hover);
    color: var(--text-primary);
    transform: translateY(-1px);
  }

  .external-icon {
    opacity: 0.65;
  }

  .project-note {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 1.15rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-soft);
    font-size: 0.7rem;
    color: var(--text-muted);
  }

  @media (max-width: 820px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .project-body {
      padding: 1.15rem;
    }

    .project-title {
      font-size: 1.15rem;
    }

    .project-meta {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.45rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card,
    .project-media img,
    .project-link {
      transition: none;
    }

    .project-card:hover,
    .project-card:hover .project-media img,
    .project-link:hover {
      transform: none;
    }
  }
</style>
