---
// SkillsSection.astro
import { cv } from '../../data/cv.js';

const { skills } = cv;

const categories = [
  { key: 'frontend', label: 'Frontend', emoji: '🎨', items: skills.frontend },
  {
    key: 'backend',
    label: 'Backend y datos',
    emoji: '⚙️',
    items: [...skills.backend, ...skills.databases],
  },
  { key: 'tools', label: 'Herramientas', emoji: '🛠️', items: skills.tools },
];
---

<section class="section skills-section" id="habilidades" aria-labelledby="habilidades-title">
  <div class="gradient-mesh" aria-hidden="true"></div>
  <div class="container">
    <div class="section-header" data-animate>
      <p class="section-label">Stack tecnológico</p>
      <h2 class="section-title" id="habilidades-title">Habilidades</h2>
      <p class="section-desc">Tecnologías con las que trabajo actualmente para construir aplicaciones modernas, escalables y eficientes.</p>
    </div>

    <div class="skills-grid">
      {categories.map((cat, ci) => (
        <div class="skill-category card" data-animate style={`animation-delay: ${ci * 0.1}s`}>
          <div class="skill-cat-header">
            <span class="skill-cat-emoji" aria-hidden="true">{cat.emoji}</span>
            <h3 class="skill-cat-title">{cat.label}</h3>
          </div>
          <div class="skill-list">
            {cat.items.map(skill => (
              <div class="skill-item">
                <div class="skill-name-row">
                  <span class="skill-name">{skill.name}</span>
                  <span class="skill-pct" aria-hidden="true">{skill.level}%</span>
                </div>
                <div
                  class="skill-bar-bg"
                  role="progressbar"
                  aria-label={`Nivel de ${skill.name}`}
                  aria-valuenow={skill.level}
                  aria-valuemin="0"
                  aria-valuemax="100"
                >
                  <div
                    class="skill-bar"
                    style={`width: ${skill.level}%`}
                    data-width={skill.level}
                  ></div>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .skills-section {
    background: var(--bg-secondary);
    overflow: hidden;
  }

  .section-header {
    margin-bottom: 3rem;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.25rem;
  }

  .skill-category {
    background: var(--bg-card);
  }

  .skill-cat-header {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border-soft);
  }

  .skill-cat-emoji {
    font-size: 1.1rem;
  }

  .skill-cat-title {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: 0.01em;
  }

  .skill-list {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .skill-item {}

  .skill-name-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.3rem;
  }

  .skill-name {
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--text-secondary);
  }

  .skill-pct {
    font-size: 0.72rem;
    font-family: var(--font-mono);
    color: var(--text-muted);
  }

  .skill-bar-bg {
    height: 5px;
    background: var(--bar-track);
    border-radius: 3px;
    overflow: hidden;
  }

  .skill-bar {
    height: 100%;
    background: linear-gradient(90deg, var(--accent-dark), var(--accent-light));
    border-radius: 3px;
    transform-origin: left;
    transition: transform 0.8s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Mejora progresiva: solo animamos si hay JS disponible */
  .js .skill-bar {
    transform: scaleX(0);
  }

  .js .skill-bar.animated {
    transform: scaleX(1);
  }

  @media (max-width: 600px) {
    .skills-grid {
      grid-template-columns: 1fr;
    }
  }

  @media print { .skills-section { display: none; } }
</style>

<script>
  // Animar barras cuando son visibles
  const bars = document.querySelectorAll('.skill-bar');
  const obs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        (e.target as HTMLElement).classList.add('animated');
      }
    });
  }, { threshold: 0.2 });

  bars.forEach(b => obs.observe(b));
</script>
