---
// EducationSection.astro
import { cv } from '../../data/cv.js';

const { education } = cv;
---

<section class="section edu-section" id="educacion" aria-labelledby="educacion-title">
  <div class="container">
    <div class="section-header" data-animate>
      <p class="section-label">Formación</p>
      <h2 class="section-title" id="educacion-title">Educación</h2>
      <p class="section-desc">Mi trayectoria académica en tecnología e informática.</p>
    </div>

    <div class="edu-grid">
      {education.map((edu, i) => (
        <div class="edu-card card" data-animate style={`animation-delay: ${i * 0.12}s`}>
          <div class="edu-top">
            <div class={`edu-status-badge ${edu.current ? 'badge-active' : 'badge-done'}`}>
              {edu.current ? (
                <>
                  <span class="badge-pulse" aria-hidden="true"></span>
                  En curso
                </>
              ) : '✓ Completado'}
            </div>
            <span class="edu-period">{edu.period}</span>
          </div>

          <div class="edu-icon" aria-hidden="true">
            <svg focusable="false" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 10v6M2 10l10-5 10 5-10 5z"/>
              <path d="M6 12v5c3 3 9 3 12 0v-5"/>
            </svg>
          </div>

          <h3 class="edu-degree">{edu.degree}</h3>
          {edu.field && <p class="edu-field">{edu.field}</p>}
          <p class="edu-institution">{edu.institution}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .edu-section {
    background: var(--bg-secondary);
  }

  .section-header {
    margin-bottom: 3rem;
  }

  .edu-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.25rem;
  }

  .edu-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    background: var(--bg-card);
    border: 1px solid var(--border-soft);
    transition: var(--transition);
    position: relative;
    overflow: hidden;
  }

  .edu-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--accent), var(--accent-light));
    opacity: 0;
    transition: var(--transition);
  }

  .edu-card:hover::before {
    opacity: 1;
  }

  .edu-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
  }

  .edu-status-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 600;
  }

  .badge-active {
    background: rgba(16, 185, 129, 0.12);
    color: #34d399;
    border: 1px solid rgba(16, 185, 129, 0.25);
  }

  .badge-done {
    background: rgba(100, 116, 139, 0.12);
    color: var(--text-secondary);
    border: 1px solid var(--border-soft);
  }

  .badge-pulse {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #10b981;
    animation: pulse-glow 2s infinite;
  }

  .edu-period {
    font-size: 0.72rem;
    font-family: var(--font-mono);
    color: var(--text-muted);
    white-space: nowrap;
  }

  .edu-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background: var(--accent-glow-sm);
    color: var(--accent-light);
    border: 1px solid var(--border);
    margin: 0.25rem 0;
  }

  .edu-degree {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.3;
  }

  .edu-field {
    font-size: 0.8rem;
    color: var(--text-secondary);
  }

  .edu-institution {
    font-size: 0.8rem;
    color: var(--accent-light);
    font-weight: 500;
    margin-top: auto;
  }

  @media (max-width: 500px) {
    .edu-grid { grid-template-columns: 1fr; }
  }

  @media print { .edu-section { display: none; } }
</style>
