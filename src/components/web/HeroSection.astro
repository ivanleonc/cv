---
// HeroSection.astro — Sección hero principal
import { cv } from '../../data/cv.js';

const { personal, social, skills, experience } = cv;
const base = import.meta.env.BASE_URL;

// Años desde el inicio en CariAI, calculados desde la experiencia real.
const MONTHS = {
  ene: 0, feb: 1, mar: 2, abr: 3, may: 4, jun: 5,
  jul: 6, ago: 7, sep: 8, oct: 9, nov: 10, dic: 11,
};

function parseStartDate(period) {
  const match = period.match(/([a-záéíóú]{3,})\.?\s+(\d{4})/i);
  if (!match) return null;
  const monthKey = match[1]
    .slice(0, 3)
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '');
  const month = MONTHS[monthKey];
  if (month === undefined) return null;
  return new Date(Number(match[2]), month, 1);
}

const startDates = experience
  .map((job) => parseStartDate(job.period))
  .filter((date) => date instanceof Date);

const yearsAtCariAI = startDates.length
  ? Math.max(1, Math.floor((Date.now() - Math.min(...startDates)) / 31_557_600_000))
  : null;

// Tecnologías únicas declaradas en cv.skills
const techCount = new Set(
  Object.values(skills).flat().map((skill) => skill.name),
).size;

const currentJob = experience.find((job) => job.current) ?? experience[0];
const footerStack = currentJob.stack.slice(0, 3).join(' · ');
---

<section class="hero" id="inicio" aria-labelledby="hero-name">
  <div class="hero-bg" aria-hidden="true">
    <div class="gradient-mesh"></div>
    <div class="hero-grid-lines"></div>
    <div class="hero-orb hero-orb-1"></div>
    <div class="hero-orb hero-orb-2"></div>
  </div>

  <div class="hero-container">
    <!-- Columna izquierda: texto -->
    <div class="hero-left">
      <div class="hero-badge animate-fade-up">
        <span class="hero-badge-dot" aria-hidden="true"></span>
        Disponible para nuevas oportunidades
      </div>

      <h1 class="hero-name animate-fade-up" id="hero-name" style="animation-delay: 0.1s">
        <span class="hero-name-first">{personal.name.split(' ')[0]}</span>{' '}
        <span class="hero-name-last">{personal.name.split(' ').slice(1).join(' ')}</span>
      </h1>

      <div class="hero-title animate-fade-up" style="animation-delay: 0.2s">
        <span class="hero-title-text" id="typewriter"></span>
        <span class="hero-cursor">|</span>
      </div>

      <p class="hero-location animate-fade-up" style="animation-delay: 0.3s">
        <svg aria-hidden="true" focusable="false" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
          <circle cx="12" cy="10" r="3"/>
        </svg>
        {personal.location}
      </p>

      <p class="hero-bio animate-fade-up" style="animation-delay: 0.35s">
        Ingeniero Informático especializado en Frontend & Development Engineering.
        Construyo plataformas web escalables con Vue.js, TypeScript y arquitecturas modernas.
      </p>

      <div class="hero-actions animate-fade-up" style="animation-delay: 0.4s">
        <a href="#experiencia" class="btn btn-primary">
          Ver experiencia
          <svg aria-hidden="true" focusable="false" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"/>
            <polyline points="12 5 19 12 12 19"/>
          </svg>
        </a>
        <button type="button" class="btn btn-outline" onclick="window.print()">
          <svg aria-hidden="true" focusable="false" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="7 10 12 15 17 10"/>
            <line x1="12" y1="15" x2="12" y2="3"/>
          </svg>
          Descargar CV
        </button>

        <div class="hero-social">
          {social.map(s => (
            <a
              href={s.url}
              target="_blank"
              rel="noopener noreferrer"
              class="social-icon-btn"
              aria-label={`${s.network} de Iván León Capote (se abre en una pestaña nueva)`}
            >
              {s.icon === 'linkedin' && (
                <svg aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
                  <rect x="2" y="9" width="4" height="12"/>
                  <circle cx="4" cy="4" r="2"/>
                </svg>
              )}
              {s.icon === 'github' && (
                <svg aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/>
                </svg>
              )}
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- Columna derecha: foto de perfil + mini badge de código -->
    <div class="hero-right animate-fade-in" style="animation-delay: 0.5s">

      <div class="hero-photo-wrap">
        <!-- Orb de fondo -->
        <div class="photo-orb" aria-hidden="true"></div>

        <!-- Anillos decorativos concéntricos -->
        <div class="photo-ring-1" aria-hidden="true"></div>
        <div class="photo-ring-2" aria-hidden="true"></div>

        <!-- Foto principal con borde gradiente -->
        <div class="photo-frame">
          <img
            src={`${base}/profile.jpg`}
            alt={personal.photoAlt}
            class="hero-photo"
            width="280"
            height="280"
            loading="eager"
          />
        </div>

        <!-- Mini tarjeta de código flotante -->
        <div class="code-mini" aria-hidden="true">
          <div class="code-mini-header">
            <span class="code-dot red"></span>
            <span class="code-dot yellow"></span>
            <span class="code-dot green"></span>
            <span class="code-mini-title">ivan.ts</span>
          </div>
          <pre class="code-mini-body"><code><span class="c-key">role</span><span class="c-op">:</span>    <span class="c-str">"Dev Engineer"</span>
<span class="c-key">stack</span><span class="c-op">:</span>   <span class="c-str">"Vue.js + TS"</span>
<span class="c-key">status</span><span class="c-op">:</span>  <span class="c-str">"open_to_work"</span></code></pre>
        </div>
      </div>

      <!-- Stats flotantes -->
      <div class="hero-stat stat-1">
        <span class="stat-number">{yearsAtCariAI}+</span>
        <span class="stat-label">años en CariAI</span>
      </div>
      <div class="hero-stat stat-2">
        <span class="stat-number">{techCount}</span>
        <span class="stat-label">tecnologías</span>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="hero-scroll" aria-hidden="true">
    <span>Scroll</span>
    <div class="scroll-line"></div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
    padding: 7rem 1.5rem 4rem;
  }

  /* ── Fondo ────────────────────────────────────────────── */
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-grid-lines {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(99, 102, 241, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(99, 102, 241, 0.04) 1px, transparent 1px);
    background-size: 60px 60px;
  }

  .hero-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    pointer-events: none;
  }

  .hero-orb-1 {
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(99, 102, 241, 0.12) 0%, transparent 70%);
    top: -100px;
    left: -100px;
  }

  .hero-orb-2 {
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(79, 70, 229, 0.08) 0%, transparent 70%);
    bottom: -50px;
    right: 10%;
  }

  /* ── Layout ───────────────────────────────────────────── */
  .hero-container {
    position: relative;
    z-index: 1;
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
    width: 100%;
  }

  /* ── Badge disponible ─────────────────────────────────── */
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    border: 1px solid rgba(16, 185, 129, 0.3);
    background: rgba(16, 185, 129, 0.08);
    font-size: 0.75rem;
    font-weight: 500;
    color: #34d399;
    margin-bottom: 1.5rem;
    animation-delay: 0s;
  }

  .hero-badge-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #10b981;
    animation: pulse-glow 2s infinite;
    flex-shrink: 0;
  }

  /* ── Nombre ───────────────────────────────────────────── */
  .hero-name {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 700;
    line-height: 1.05;
    margin-bottom: 1rem;
    letter-spacing: -0.03em;
  }

  .hero-name-first {
    color: var(--text-primary);
  }

  .hero-name-last {
    color: var(--accent-light);
  }

  /* ── Título animado ───────────────────────────────────── */
  .hero-title {
    font-size: clamp(1rem, 2.5vw, 1.3rem);
    font-family: var(--font-mono);
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
    display: flex;
    align-items: center;
    gap: 2px;
    min-height: 2rem;
  }

  .hero-title-text {
    color: var(--accent-light);
  }

  .hero-cursor {
    color: var(--accent);
    animation: blink 1s step-end infinite;
    font-weight: 300;
  }

  /* ── Ubicación ────────────────────────────────────────── */
  .hero-location {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--text-muted);
    font-size: 0.875rem;
    margin-bottom: 1.25rem;
  }

  .hero-location svg {
    color: var(--accent);
    flex-shrink: 0;
  }

  /* ── Bio ──────────────────────────────────────────────── */
  .hero-bio {
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.75;
    max-width: 480px;
    margin-bottom: 2rem;
  }

  /* ── Acciones ─────────────────────────────────────────── */
  .hero-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .hero-social {
    display: flex;
    gap: 0.5rem;
    margin-left: 0.5rem;
  }

  .social-icon-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    border: 1px solid var(--border-soft);
    color: var(--text-secondary);
    transition: var(--transition);
  }

  .social-icon-btn:hover {
    border-color: var(--border);
    color: var(--accent-light);
    background: var(--accent-glow-sm);
    transform: translateY(-2px);
  }

  /* ── Foto de perfil (derecha) ────────────────────────────── */
  .hero-right {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    animation: float 5s ease-in-out infinite;
  }

  .hero-photo-wrap {
    position: relative;
    width: 300px;
    height: 340px;
    flex-shrink: 0;
  }

  /* Orb de resplandor */
  .photo-orb {
    position: absolute;
    inset: -60px;
    background: radial-gradient(circle at 50% 45%, rgba(99,102,241,0.25) 0%, transparent 65%);
    filter: blur(50px);
    pointer-events: none;
    z-index: 0;
  }

  /* Anillos concéntricos giratorios */
  .photo-ring-1,
  .photo-ring-2 {
    position: absolute;
    border-radius: 50%;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -55%);
    pointer-events: none;
    z-index: 0;
  }

  .photo-ring-1 {
    width: 310px;
    height: 310px;
    border: 1px solid rgba(99,102,241,0.2);
    animation: rotate-ring 25s linear infinite;
  }

  .photo-ring-2 {
    width: 350px;
    height: 350px;
    border: 1px dashed rgba(99,102,241,0.08);
    animation: rotate-ring 40s linear infinite reverse;
  }

  /* Marco con borde gradiente */
  .photo-frame {
    position: relative;
    z-index: 1;
    width: 280px;
    height: 280px;
    border-radius: 50%;
    padding: 3px;
    background: linear-gradient(135deg, #6366f1 0%, #818cf8 50%, #4f46e5 100%);
    box-shadow:
      0 20px 60px rgba(0,0,0,0.6),
      0 0 0 8px rgba(99,102,241,0.1),
      0 0 60px rgba(99,102,241,0.15);
    margin: 0 auto;
  }

  .hero-photo {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    display: block;
    object-fit: cover;
    object-position: top center;
  }

  /* Mini badge de código flotante */
  .code-mini {
    position: absolute;
    z-index: 2;
    bottom: 0;
    right: -16px;
    background: var(--bg-card);
    border: 1px solid var(--border-soft);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 8px 32px rgba(0,0,0,0.5), 0 0 0 1px rgba(99,102,241,0.1);
    min-width: 190px;
  }

  .code-mini-header {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 7px 10px;
    background: rgba(0,0,0,0.25);
    border-bottom: 1px solid var(--border-soft);
  }

  .code-mini-title {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: var(--text-muted);
    margin-left: 4px;
  }

  .code-mini-body {
    padding: 10px 14px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1.65;
    white-space: pre;
    margin: 0;
  }

  .code-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .code-dot.red    { background: #ff5f57; }
  .code-dot.yellow { background: #febc2e; }
  .code-dot.green  { background: #28c840; }

  .c-key { color: #f07178; }
  .c-op  { color: #89ddff; }
  .c-str { color: #c3e88d; }

  @keyframes rotate-ring {
    from { transform: translate(-50%, -55%) rotate(0deg); }
    to   { transform: translate(-50%, -55%) rotate(360deg); }
  }

  /* ── Stats flotantes ──────────────────────────────────── */
  .hero-stat {
    position: absolute;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 0.75rem 1rem;
    text-align: center;
    min-width: 90px;
    box-shadow: var(--shadow-card);
  }

  .stat-number {
    display: block;
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--accent-light);
    line-height: 1;
  }

  .stat-label {
    display: block;
    font-size: 0.65rem;
    color: var(--text-muted);
    margin-top: 0.2rem;
    white-space: nowrap;
  }

  .stat-1 { bottom: -56px; left: -18px; }
  .stat-2 { top: -16px; right: -20px; }

  /* ── Scroll indicator ─────────────────────────────────── */
  .hero-scroll {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-muted);
    font-size: 0.7rem;
    font-family: var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    z-index: 1;
    animation: fadeIn 1s ease 1s both;
  }

  .scroll-line {
    width: 1px;
    height: 40px;
    background: linear-gradient(to bottom, var(--accent), transparent);
    animation: float 2s ease-in-out infinite;
  }

  /* ── Responsive ───────────────────────────────────────── */
  @media (max-width: 900px) {
    .hero-container {
      grid-template-columns: 1fr;
      gap: 3rem;
      text-align: center;
    }

    .hero-left {
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .hero-bio { text-align: left; }

    .hero-right {
      animation: none;
    }

    .stat-1, .stat-2 { display: none; }

    /* Ocultar scroll indicator en móvil */
    .hero-scroll { display: none; }

    /* Foto más compacta en móvil */
    .hero-photo-wrap { width: 240px; height: 280px; }
    .photo-frame { width: 220px; height: 220px; }
    .photo-ring-1 { width: 240px; height: 240px; }
    .photo-ring-2 { width: 270px; height: 270px; }
    .code-mini { right: -8px; bottom: -4px; min-width: 170px; }
    .code-mini-body { font-size: 0.65rem; padding: 8px 10px; }
  }

  @media (max-width: 480px) {
    .hero { padding: 6rem 1rem 3rem; }
    .hero-actions { gap: 0.5rem; }
    .hero-social { margin-left: 0; }
  }

  @media print {
    .hero { display: none; }
  }
</style>

<script>
  // Typewriter effect (desactivado si el usuario prefiere movimiento reducido)
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const titles = [
    'Development Engineer',
    'Frontend Developer',
    'Vue.js Specialist',
    'API & WebSockets Dev',
  ];

  const el = document.getElementById('typewriter');

  if (el && prefersReducedMotion) {
    el.textContent = titles[0];
  } else if (el) {
    let titleIdx = 0;
    let charIdx = 0;
    let deleting = false;

    const type = () => {
      const current = titles[titleIdx];

      if (!deleting) {
        el.textContent = current.substring(0, charIdx + 1);
        charIdx++;
        if (charIdx === current.length) {
          deleting = true;
          setTimeout(type, 1800);
          return;
        }
        setTimeout(type, 60);
      } else {
        el.textContent = current.substring(0, charIdx - 1);
        charIdx--;
        if (charIdx === 0) {
          deleting = false;
          titleIdx = (titleIdx + 1) % titles.length;
        }
        setTimeout(type, 35);
      }
    };

    setTimeout(type, 800);
  }
</script>
