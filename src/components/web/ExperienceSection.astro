---
// ExperienceSection.astro
import { cv } from '../../data/cv.js';

const { experience } = cv;
---

<section class="section exp-section" id="experiencia" aria-labelledby="experiencia-title">
  <div class="container">
    <div class="section-header" data-animate>
      <p class="section-label">Trayectoria profesional</p>
      <h2 class="section-title" id="experiencia-title">Experiencia</h2>
      <p class="section-desc">Mi recorrido profesional en el desarrollo de software y plataformas de inteligencia artificial.</p>
    </div>

    <div class="exp-timeline">
      {experience.map((job, i) => (
        <div class="exp-entry" data-animate style={`animation-delay: ${i * 0.15}s`}>
          <!-- Línea timeline -->
          <div class="timeline-col" aria-hidden="true">
            <div class={`timeline-dot ${job.current ? 'dot-current' : 'dot-past'}`}>
              {job.current && <span class="dot-pulse"></span>}
            </div>
            {i < experience.length - 1 && <div class="timeline-line"></div>}
          </div>

          <!-- Contenido -->
          <div class="exp-content card">
            <div class="exp-header">
              <div>
                <h3 class="exp-role">{job.role}</h3>
                <p class="exp-company">{job.company}</p>
              </div>
              <div class="exp-meta">
                <span class={`pill ${job.current ? 'pill-current' : 'pill-done'}`}>
                  {job.current ? '● Actual' : '✓ Finalizado'}
                </span>
                <span class="exp-period">
                  <svg aria-hidden="true" focusable="false" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                    <line x1="16" y1="2" x2="16" y2="6"/>
                    <line x1="8" y1="2" x2="8" y2="6"/>
                    <line x1="3" y1="10" x2="21" y2="10"/>
                  </svg>
                  {job.period}
                </span>
              </div>
            </div>

            <p class="exp-desc">{job.description}</p>

            <ul class="exp-bullets">
              {job.responsibilities.map(r => (
                <li>
                  <span class="bullet-arrow" aria-hidden="true">›</span>
                  {r}
                </li>
              ))}
            </ul>

            <div class="exp-stack">
              {job.stack.map(tech => (
                <span class="pill pill-tech">{tech}</span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .exp-section {
    background: var(--bg-primary);
  }

  .section-header {
    margin-bottom: 3rem;
  }

  .exp-timeline {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .exp-entry {
    display: grid;
    grid-template-columns: 32px 1fr;
    gap: 1.25rem;
    position: relative;
  }

  /* ── Timeline column ──────────────────────────────────── */
  .timeline-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 1.5rem;
  }

  .timeline-dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    flex-shrink: 0;
    position: relative;
    z-index: 1;
  }

  .dot-current {
    background: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-glow);
  }

  .dot-pulse {
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    border: 2px solid var(--accent);
    animation: pulse-glow 2s infinite;
  }

  .dot-past {
    background: var(--bg-card);
    border: 2px solid var(--border);
  }

  .timeline-line {
    width: 1px;
    flex: 1;
    background: linear-gradient(to bottom, var(--border), transparent);
    margin: 0.5rem 0;
    min-height: 2rem;
  }

  /* ── Contenido ────────────────────────────────────────── */
  .exp-content {
    margin-bottom: 1.5rem;
  }

  .exp-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }

  .exp-role {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.2rem;
  }

  .exp-company {
    font-size: 0.875rem;
    color: var(--accent-light);
    font-weight: 500;
  }

  .exp-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.4rem;
  }

  .exp-period {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.75rem;
    font-family: var(--font-mono);
    color: var(--text-muted);
    white-space: nowrap;
  }

  .exp-desc {
    color: var(--text-secondary);
    font-size: 0.875rem;
    line-height: 1.7;
    margin-bottom: 1rem;
  }

  .exp-bullets {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .exp-bullets li {
    display: flex;
    gap: 0.5rem;
    font-size: 0.84rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .bullet-arrow {
    color: var(--accent);
    flex-shrink: 0;
    font-size: 1rem;
    line-height: 1.6;
  }

  .exp-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  @media (max-width: 600px) {
    .exp-header {
      flex-direction: column;
    }
    .exp-meta {
      align-items: flex-start;
    }
  }

  @media print { .exp-section { display: none; } }
</style>
