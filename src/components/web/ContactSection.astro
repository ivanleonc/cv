---
// ContactSection.astro
import { cv } from '../../data/cv.js';

const { personal, social } = cv;
---

<section class="section contact-section" id="contacto" aria-labelledby="contacto-title">
  <div class="contact-bg" aria-hidden="true">
    <div class="gradient-mesh"></div>
    <div class="contact-grid-lines"></div>
  </div>

  <div class="container contact-inner">
    <div class="contact-left" data-animate>
      <p class="section-label">¿Hablamos?</p>
      <h2 class="contact-title" id="contacto-title">Listo para conectar</h2>
      <p class="contact-desc">
        Estoy abierto a nuevas oportunidades, colaboraciones y proyectos
        interesantes en el mundo del desarrollo web. ¡Será un gusto conectar contigo!
      </p>

      <div class="contact-links">
        <a href={`mailto:${personal.email}`} class="contact-link">
          <div class="contact-link-icon">
            <svg aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
              <polyline points="22,6 12,13 2,6"/>
            </svg>
          </div>
          <div>
            <span class="contact-link-label">Email</span>
            <span class="contact-link-value">{personal.email}</span>
          </div>
        </a>

        {personal.emailAlt && (
          <a href={`mailto:${personal.emailAlt}`} class="contact-link">
            <div class="contact-link-icon">
              <svg aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                <polyline points="22,6 12,13 2,6"/>
              </svg>
            </div>
            <div>
              <span class="contact-link-label">Email institucional</span>
              <span class="contact-link-value">{personal.emailAlt}</span>
            </div>
          </a>
        )}

        {social.map(s => (
          <a
            href={s.url}
            target="_blank"
            rel="noopener noreferrer"
            class="contact-link"
            aria-label={`${s.network}: @${s.handle} (se abre en una pestaña nueva)`}
          >
            <div class="contact-link-icon">
              {s.icon === 'linkedin' && (
                <svg aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
                  <rect x="2" y="9" width="4" height="12"/>
                  <circle cx="4" cy="4" r="2"/>
                </svg>
              )}
              {s.icon === 'github' && (
                <svg aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/>
                </svg>
              )}
            </div>
            <div>
              <span class="contact-link-label">{s.network}</span>
              <span class="contact-link-value">@{s.handle}</span>
            </div>
          </a>
        ))}
      </div>
    </div>

    <div class="contact-right" data-animate style="animation-delay: 0.2s">
      <div class="download-card">
        <div class="download-card-top">
          <div class="download-icon">
            <svg aria-hidden="true" focusable="false" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
              <polyline points="14 2 14 8 20 8"/>
              <line x1="12" y1="18" x2="12" y2="12"/>
              <polyline points="9 15 12 18 15 15"/>
            </svg>
          </div>
          <div>
            <h3 class="download-title">Descargar CV</h3>
            <p class="download-subtitle">Formato A4 · Listo para imprimir</p>
          </div>
        </div>
        <p class="download-desc">
          Descarga mi hoja de vida en PDF con un diseño profesional de dos columnas,
          listo para enviar a reclutadores y empresas.
        </p>
        <div class="download-info">
          <span class="pill pill-tech">PDF A4</span>
          <span class="pill pill-tech">2 columnas</span>
          <span class="pill pill-tech">Texto seleccionable</span>
        </div>
        <button type="button" class="btn btn-primary download-btn" onclick="window.print()">
          <svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="7 10 12 15 17 10"/>
            <line x1="12" y1="15" x2="12" y2="3"/>
          </svg>
          Descargar CV en PDF
        </button>
        <p class="download-hint">
          Se abrirá el diálogo de impresión del navegador.<br/>
          Selecciona "Guardar como PDF" para descargar.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-section {
    background: var(--bg-secondary);
    position: relative;
    overflow: hidden;
  }

  .contact-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .contact-grid-lines {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(99, 102, 241, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(99, 102, 241, 0.03) 1px, transparent 1px);
    background-size: 50px 50px;
  }

  .contact-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
  }

  /* ── Left ─────────────────────────────────────────────── */
  .contact-title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 1rem;
    margin-top: 0.5rem;
  }

  .contact-desc {
    color: var(--text-secondary);
    line-height: 1.75;
    margin-bottom: 2rem;
  }

  .contact-links {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .contact-link {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.9rem 1.1rem;
    background: var(--bg-card);
    border: 1px solid var(--border-soft);
    border-radius: var(--card-radius);
    transition: var(--transition);
  }

  .contact-link:hover {
    border-color: var(--border);
    background: var(--bg-card-hover);
    transform: translateX(4px);
  }

  .contact-link-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 9px;
    background: var(--accent-glow-sm);
    color: var(--accent-light);
    border: 1px solid var(--border);
    flex-shrink: 0;
  }

  .contact-link-label {
    display: block;
    font-size: 0.7rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.1rem;
  }

  .contact-link-value {
    display: block;
    font-size: 0.875rem;
    color: var(--text-primary);
    font-weight: 500;
  }

  /* ── Download card ────────────────────────────────────── */
  .download-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    box-shadow: var(--shadow-accent);
    position: sticky;
    top: 80px;
  }

  .download-card-top {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .download-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: 12px;
    background: var(--accent-glow);
    color: var(--accent-light);
    border: 1px solid var(--border-hover);
    flex-shrink: 0;
  }

  .download-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .download-subtitle {
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-top: 0.1rem;
  }

  .download-desc {
    font-size: 0.84rem;
    color: var(--text-secondary);
    line-height: 1.65;
  }

  .download-info {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .download-btn {
    width: 100%;
    justify-content: center;
    padding: 0.85rem;
    font-size: 0.9rem;
  }

  .download-hint {
    font-size: 0.72rem;
    color: var(--text-muted);
    text-align: center;
    line-height: 1.6;
  }

  /* ── Responsive ───────────────────────────────────────── */
  @media (max-width: 800px) {
    .contact-inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .download-card {
      position: static;
    }
  }

  @media print { .contact-section { display: none; } }
</style>
